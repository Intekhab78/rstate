# ══════════════════════════════════════════════
#   RState Project — Root .gitignore
# ══════════════════════════════════════════════

# ─── Dependencies ─────────────────────────────
node_modules/
.pnp
.pnp.js

# ─── Environment Variables (NEVER commit!) ────
.env
.env.*
!.env.example

# ─── Logs ─────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── Build Outputs ────────────────────────────
dist/
dist-ssr/
build/

# ─── Database Files ───────────────────────────
*.sqlite
*.sqlite3
*.db
data/*.sqlite
data/*.db

# ─── File Uploads (user-uploaded files) ───────
backend/uploads/*
!backend/uploads/.gitkeep

# ─── MongoDB Backup / Migration Scripts ───────
mongodb_backup/
migrate_to_vps.cjs
migrate_to_vps.js

# ─── OS Generated Files ───────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# ─── Editor & IDE ─────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp

# ─── Package Manager ──────────────────────────
package-lock.json
yarn.lock
pnpm-lock.yaml

# ─── Temp & Cache ─────────────────────────────
.cache/
.temp/
.tmp/
*.tmp
