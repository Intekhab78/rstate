# ══════════════════════════════════════════════
#   Backend .gitignore
# ══════════════════════════════════════════════

# ─── Dependencies ─────────────────────────────
node_modules/

# ─── Environment Variables ────────────────────
.env
.env.*
!.env.example

# ─── Database Files ───────────────────────────
*.sqlite
*.sqlite3
*.db
data/*.sqlite
data/*.db

# ─── File Uploads ─────────────────────────────
uploads/*
!uploads/.gitkeep

# ─── Migration Scripts ────────────────────────
migrate_to_vps.cjs
migrate_to_vps.js

# ─── Logs ─────────────────────────────────────
logs/
*.log

# ─── OS / Editor ──────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
